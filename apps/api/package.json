{
  "name": "@grido/api",
  "version": "0.0.0",
  "private": true,
  "description": "Express API for Grido Analytics. In production it also serves the built web app.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@grido/shared": "workspace:*",
    "exceljs": "~4.4.0",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "pdfmake": "~0.3.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pdfmake": "~0.3.3",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}

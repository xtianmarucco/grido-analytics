{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "buildCommand": "pnpm run vercel-build",
  "regions": ["gru1"],
  "functions": {
    "index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [{ "source": "/((?!api(?:/|$)|assets/).*)", "destination": "/index.html" }]
}

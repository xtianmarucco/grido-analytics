# Interface the API binds to. Keep 127.0.0.1 so the app is not reachable from other machines.
HOST=127.0.0.1
# Port for the API (and, in production, the web app served from the same origin).
PORT=3001
# Runtime environment label (development | test | production). Does not toggle web serving.
NODE_ENV=development
# Optional: path to a web build to serve. Defaults to apps/web/dist. When that folder contains an
# index.html, the API also serves the web app from the same origin (production mode).
# WEB_DIST_DIR=
